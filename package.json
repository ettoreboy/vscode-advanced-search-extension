{
    "name": "vscode-websearch",
    "displayName": "vscode-websearch",
    "description": "Open Github, Stackoverflow or Google and search the web with your selected text",
    "version": "1.4.0",
    "publisher": "ettoreciprian",
    "icon": "icons/icon.png",
    "galleryBanner": {
        "color": "#008000",
        "theme": "dark"
    },
    "license": "MIT",
    "repository": {
        "url": "https://github.com/ettoreboy/vscode-advanced-search-extension",
        "type": "git"
    },
    "homepage": "https://github.com/ettoreboy/vscode-advanced-search-extension",
    "bugs": {
        "url": "https://github.com/ettoreboy/vscode-advanced-search-extension/issues"
    },
    "engines": {
        "vscode": "^1.28.0",
        "node": ">=22.13.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:websearch.github",
        "onCommand:websearch.stackoverflow",
        "onCommand:websearch.google",
        "onCommand:websearch.customSearchProvider"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "websearch.github",
                "title": "Github",
                "category": "Web Search"
            },
            {
                "command": "websearch.stackoverflow",
                "title": "StackOverflow",
                "category": "Web Search"
            },
            {
                "command": "websearch.google",
                "title": "Google",
                "category": "Web Search"
            },
            {
                "command": "websearch.customSearchProvider",
                "title": "Custom provider",
                "category": "Web Search"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "websearch.google",
                    "when": "editorHasSelection",
                    "group": "z_commands"
                },
                {
                    "command": "websearch.github",
                    "when": "editorHasSelection",
                    "group": "z_commands"
                },
                {
                    "command": "websearch.stackoverflow",
                    "when": "editorHasSelection",
                    "group": "z_commands"
                }
            ],
            "touchBar": [
                {
                    "command": "websearch.google",
                    "when": "editorHasSelection",
                    "group": "search"
                },
                {
                    "command": "websearch.github",
                    "when": "editorHasSelection",
                    "group": "search"
                },
                {
                    "command": "websearch.stackoverflow",
                    "when": "editorHasSelection",
                    "group": "search"
                }
            ]
        },
        "configuration": {
            "title": "WebSearch Configuration",
            "type": "object",
            "properties": {
                "websearch.google": {
                    "title": "Google search command",
                    "type": "object",
                    "default": {
                        "name": "google",
                        "baseUrl": "https://www.google.com/search",
                        "defaultQuery": {},
                        "defaultParams": {}
                    }
                },
                "websearch.github": {
                    "title": "Github search command",
                    "type": "object",
                    "default": {
                        "name": "github",
                        "baseUrl": "https://github.com/search",
                        "defaultQuery": {},
                        "defaultParams": {
                            "type": "code"
                        }
                    }
                },
                "websearch.stackoverflow": {
                    "title": "Stackoverflow search command",
                    "type": "object",
                    "default": {
                        "name": "stackoverflow",
                        "baseUrl": "https://stackoverflow.com/search",
                        "defaultQuery": {
                            "is": "answer"
                        },
                        "defaultParams": {}
                    }
                },
                "websearch.customSearchProvider": {
                    "title": "Search providers",
                    "type": "object",
                    "description": "A custom search provider. Set a baseUrl to enable the 'Web Search: Custom provider' command.",
                    "default": {
                        "name": "customwebsearch",
                        "baseUrl": "",
                        "defaultQuery": {},
                        "defaultParams": {}
                    }
                },
                "websearch.activateInputBox": {
                    "title": "Enable the input box if not text is selected or there is not editor open",
                    "type": "boolean",
                    "description": "Uncheck this to disable the input box that will appear if no text is selected.",
                    "default": true
                },
                "websearch.defaultBrowser": {
                    "type": "string",
                    "description": "The default browser, options are: system|firefox|brave|google-chrome|safari",
                    "default": "system",
                    "pattern": "system|firefox|brave|google-chrome|safari"
                },
                "websearch.searchProviders": {
                    "title": "Deprecated Search providers",
                    "type": "array",
                    "description": "A list of search provider",
                    "default": [],
                    "deprecationMessage": "This property has been depreacted in favour of custom or individual properties. Please read: https://github.com/ettoreboy/vscode-advanced-search-extension"
                }
            }
        },
        "keybindings": [
            {
                "command": "websearch.github",
                "key": "ctrl+alt+H"
            },
            {
                "command": "websearch.stackoverflow",
                "key": "ctrl+alt+O"
            },
            {
                "command": "websearch.google",
                "key": "ctrl+alt+G"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTests.js",
        "lint": "eslint .",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.20.5",
        "@types/vscode": "^1.28.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^10.13.0",
        "mocha": "^12.0.3",
        "ts-mockito": "^2.6.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0"
    },
    "dependencies": {
        "open": "^8.4.2"
    },
    "overrides": {
        "@azure/msal-node": "^7.1.1"
    }
}
